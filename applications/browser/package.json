{
  "private": true,
  "name": "cicerone-browser",
  "version": "0.1.0",
  "dependencies": {
    "@cicerone/core": "0.1.0",
    "@cicerone/litellm": "0.1.0",
    "@cicerone/shape": "0.1.0",
    "@theia/ai-anthropic": "1.77.0",
    "@theia/ai-chat": "1.77.0",
    "@theia/ai-chat-ui": "1.77.0",
    "@theia/ai-core": "1.77.0",
    "@theia/ai-core-ui": "1.77.0",
    "@theia/ai-google": "1.77.0",
    "@theia/ai-history": "1.77.0",
    "@theia/ai-ide": "1.77.0",
    "@theia/ai-mcp": "1.77.0",
    "@theia/ai-ollama": "1.77.0",
    "@theia/ai-openai": "1.77.0",
    "@theia/core": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/file-search": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/keymaps": "1.77.0",
    "@theia/markers": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/outline-view": "1.77.0",
    "@theia/plugin-ext": "1.77.0",
    "@theia/plugin-ext-vscode": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/process": "1.77.0",
    "@theia/search-in-workspace": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/userstorage": "1.77.0",
    "@theia/variable-resolver": "1.77.0",
    "@theia/workspace": "1.77.0"
  },
  "devDependencies": {
    "@theia/cli": "1.77.0"
  },
  "scripts": {
    "build": "theia build --mode development",
    "build:prod": "theia build",
    "rebuild": "theia rebuild:browser --cacheRoot ../..",
    "start": "theia start --plugins=local-dir:../../plugins",
    "download:plugins": "theia download:plugins --rate-limit=15 --parallel=false"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Cicerone",
        "preferences": {
          "files.enableTrash": false,
          "ai-features.AiEnable.enableAI": true,
          "ai-features.chat.defaultChatAgent": "Cicerone",
          "ai-features.chat.toolConfirmation": {
            "read": "always_allow",
            "find": "always_allow",
            "edit": "always_allow",
            "show": "always_allow",
            "skill": "always_allow"
          },
          "[markdown]": {
            "editor.wordWrap": "on"
          },
          "[plaintext]": {
            "editor.wordWrap": "on"
          },
          "diffEditor.wordWrap": "inherit",
          "ai-features.agentSettings": {
            "Coder": {
              "enable": false
            },
            "Architect": {
              "enable": false
            },
            "Orchestrator": {
              "enable": false
            },
            "Universal": {
              "enable": false
            },
            "explore": {
              "enable": false
            },
            "code-reviewer": {
              "enable": false
            },
            "GitHub": {
              "enable": false
            },
            "AppTester": {
              "enable": false
            },
            "Command": {
              "enable": false
            },
            "CreateSkill": {
              "enable": false
            },
            "AgentsMd": {
              "enable": false
            },
            "pr-reviewer": {
              "enable": false
            }
          },
          "workbench.startupEditor": "none"
        }
      }
    }
  },
  "theiaPluginsDir": "../../plugins",
  "theiaPlugins": {
    "eclipse-theia.builtin-extension-pack": "https://open-vsx.org/api/eclipse-theia/builtin-extension-pack/1.95.3/file/eclipse-theia.builtin-extension-pack-1.95.3.vsix"
  },
  "theiaPluginsExcludeIds": [
    "ms-vscode.js-debug-companion",
    "VisualStudioExptTeam.vscodeintellicode",
    "vscode.extension-editing",
    "vscode.github",
    "vscode.github-authentication",
    "vscode.microsoft-authentication"
  ]
}
